{
  "name": "@myminijob/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "node scripts/prisma.mjs generate",
    "validate": "node scripts/prisma.mjs validate",
    "migrate": "tsx scripts/migrate.ts",
    "migrate:status": "tsx scripts/migrate.ts --status",
    "seed": "tsx scripts/seed.ts",
    "reset": "tsx scripts/migrate.ts --reset && tsx scripts/seed.ts",
    "check-drift": "tsx scripts/check-drift.ts",
    "import-catalog": "tsx scripts/import-catalog.ts",
    "schema-sql": "node scripts/schema-to-sql.mjs prisma/schema.prisma",
    "typecheck": "tsc --noEmit",
    "postinstall": "node scripts/prisma.mjs generate"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@myminijob/core": "workspace:*",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@prisma/internals": "7.10.1",
    "@types/node": "24.10.1",
    "@types/pg": "8.23.1",
    "dotenv": "17.4.2",
    "prisma": "7.10.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "@node-rs/argon2": "2.2.2"
  }
}
