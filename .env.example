# ---------------------------------------------------------------------------
# My Minijob – Umgebungsvariablen. Kopieren nach .env (Wurzel) und packages/db/.env
# Werte ohne Kommentar "PFLICHT" sind optional; ohne sie laufen klar markierte Testadapter.
# ---------------------------------------------------------------------------

# PFLICHT: PostgreSQL 16 (mit pg_trgm)
DATABASE_URL=postgresql://myminijob:myminijob@localhost:5432/myminijob
# PFLICHT: öffentliche Basis-URL (für Links in E-Mails, CSRF-Origin-Prüfung)
APP_URL=http://localhost:3000
# PFLICHT in Produktion: zufälliger Schlüssel ≥ 32 Zeichen (z. B. `openssl rand -hex 32`)
SESSION_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars

# Redis (Rate Limits, Chat-Pub/Sub). Ohne: In-Memory-Rate-Limit, Chat per Polling.
REDIS_URL=redis://localhost:6379

# Echtzeit-Chat (apps/realtime)
REALTIME_PORT=3001
NEXT_PUBLIC_REALTIME_URL=ws://localhost:3001

# Objektspeicher (privat). Ohne S3_*: lokaler privater Ordner apps/web/.storage (nur Entwicklung).
S3_ENDPOINT=http://localhost:9000
S3_REGION=eu-central-1
S3_BUCKET=myminijob-private
S3_ACCESS_KEY_ID=myminijob
S3_SECRET_ACCESS_KEY=myminijob-secret
S3_FORCE_PATH_STYLE=true

# Upload-Virenscan via ClamAV (clamd). Ohne: Dateien werden als "nicht gescannt" markiert.
CLAMAV_HOST=
CLAMAV_PORT=3310

# E-Mail. Ohne SMTP_HOST werden Mails nur in der Tabelle OutboxEmail gespeichert (Dev-Postfach unter /dev/mails).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM="My Minijob <no-reply@example.invalid>"

# Web-Push (VAPID). Ohne: Push deaktiviert, In-App- und E-Mail-Benachrichtigungen funktionieren.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:kontakt@example.invalid

# KI (Anthropic). Ohne Schlüssel: regelbasierte Suche + Assistent im klar gekennzeichneten Basismodus.
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-5-5
AI_MAX_OUTPUT_TOKENS=800

# Zahlungen. Nur "test" ist implementiert (kein echtes Geld). Live-Provider erst nach Vertrags-/Rechtsprüfung.
PAYMENT_PROVIDER=test

# Steuer-Modus für Gebührenrechnungen: REGULAR (19 % USt. enthalten) | KLEINUNTERNEHMER (§ 19 UStG)
INVOICE_TAX_MODE=REGULAR
# Betreiberangaben (erscheinen auf Rechnungen und im Impressum) – PLATZHALTER ERSETZEN
OPERATOR_NAME="[Betreibername eintragen]"
OPERATOR_ADDRESS="[Straße Nr., PLZ Ort]"
OPERATOR_VAT_ID="[USt-IdNr. oder Steuernummer]"
OPERATOR_EMAIL="[kontakt@domain.de]"
OPERATOR_IBAN="[IBAN für Überweisungen]"

# Seed
SEED_DEMO=1
SEED_DEMO_PASSWORD=Demo-Passwort-2026
